# Copy to .env (never commit .env).

# The MCP server's token: fine-grained PAT, READ-ONLY (Metadata, Contents, Issues, Pull requests).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# v1 = deliberately vague descriptions (baseline), v1b = v1 text + bare repo names, v2 = optimized
GITHUB_MCP_TOOLSET=v2

# Eval placeholders: questions use {repo}, {repo_name}, {repo2}, {owner}.
# Use the repos eval/seed_repos.py creates, so every question has a known answer.
EVAL_REPO=your-login/mcp-bench-app
EVAL_REPO2=your-login/mcp-bench-lib

# Only for eval/seed_repos.py: a SEPARATE short-lived token with write access. Delete it after seeding.
GITHUB_SEED_TOKEN=

# Only needed for the Claude backend of the eval harness
ANTHROPIC_API_KEY=
